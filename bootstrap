#!/usr/bin/env bash
#
# Installs everything the shell config expects to exist.
# Idempotent: safe to re-run, skips anything already present.

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log() { printf '\n==> %s\n' "$1"; }

# Homebrew
if ! command -v brew >/dev/null 2>&1; then
  log "Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# brew trust
if brew trust --help >/dev/null 2>&1; then
  log "Trusting third-party taps"
  while IFS= read -r tap_name; do
    printf '  %s\n' "$tap_name"
    brew trust --tap "$tap_name" >/dev/null
  done < <(sed -nE 's/^tap "([^"]+)".*/\1/p' "${BASEDIR}/Brewfile")
fi

# brew install
if brew bundle check --no-upgrade --file="${BASEDIR}/Brewfile" >/dev/null 2>&1; then
  log "Brewfile already satisfied"
else
  log "Installing Brewfile packages"
  brew bundle install --no-upgrade --file="${BASEDIR}/Brewfile"
fi

# agent CLIs
#
# Installed from each vendor's standalone installer rather than Homebrew: they
# ship often and self-update in place, while brew formulas lag and need a
# manual `brew upgrade`.
#
# Presence is checked by install path, not `command -v`, so a machine still
# running a Homebrew copy gets migrated instead of skipped.
#
# The Homebrew copies are removed FIRST because the codex installer only leaves
# shell rc files alone when it finds no competing package manager -- and the rc
# files it would edit (~/.zprofile, ~/.zshrc) are dotbot symlinks into this
# repo, so it would rewrite tracked files in place.

for pkg in codex opencode; do
  if brew list "$pkg" >/dev/null 2>&1; then
    log "Removing Homebrew $pkg (superseded by standalone installer)"
    brew uninstall --force "$pkg" >/dev/null 2>&1 || true
  fi
done

# ~/.local/bin is already on PATH via zprofile, so these two skip rc edits.
if [ ! -x "${HOME}/.local/bin/claude" ]; then
  log "Installing Claude Code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

if [ ! -x "${HOME}/.local/bin/codex" ]; then
  log "Installing Codex"
  curl -fsSL https://chatgpt.com/codex/install.sh | sh
fi

# opencode hardcodes ~/.opencode/bin, so PATH comes from zprofile and the
# installer is told explicitly not to touch shell config.
if [ ! -x "${HOME}/.opencode/bin/opencode" ]; then
  log "Installing opencode"
  curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path
fi

# workmux agent status hooks
#
# Normally self-healing: workmux prompts on first interactive run when it finds
# an agent without status tracking. That prompt never fires on a dispatch-only
# host like the mini, where worktrees are created over ssh and nobody is sitting
# at a terminal -- and without the hooks `workmux status` reports zero agents no
# matter how many are running, which is what the dashboard reads.
#
# `workmux setup` itself refuses to run without a TTY, so this can only report.
if command -v workmux >/dev/null 2>&1 &&
   ! grep -q workmux "${HOME}/.claude/settings.json" 2>/dev/null; then
  log "workmux status hooks missing -- run: workmux setup --hooks"
fi

# ssh
#
# ControlPath's directory has to exist before ssh will multiplex; ssh won't
# create it, and the failure is an obscure error rather than a clear one.
#
# ~/.ssh is normally made by ssh itself at 0700, but on a virgin machine
# dotbot gets there first (creating it on the way to ~/.ssh/config.d) and
# leaves it 0755. ssh tolerates that -- it only rejects group/world-writable
# -- but there's no reason for the directory to be world-readable.
mkdir -p -m 700 "${HOME}/.ssh/sockets"
chmod 700 "${HOME}/.ssh"

# The tracked host definitions (ssh/mini.conf, linked into ~/.ssh/config.d)
# only apply if ~/.ssh/config includes them.
#
# Editing this file is worth doing carefully: a malformed line, a truncated
# write, or a group-writable mode each make ssh refuse to run at all, which
# takes git with it. Hence the three guards -- the candidate is built in a
# temp file, parse-checked with `ssh -G` (exit 255 on a bad config, and no
# network involved), and only then renamed into place. A failure aborts here
# with the original file untouched, which is the same outcome as never having
# run: no multiplexing, nothing broken.
#
# Prepended rather than appended because `Include` has to precede the Host
# blocks it should apply to. Landing above OrbStack's include is harmless --
# neither sets a keyword the other does, and ssh takes the first value found.
ssh_config="${HOME}/.ssh/config"
if [ ! -e "$ssh_config" ] ||
   ! grep -q '^[[:space:]]*Include[[:space:]].*\.ssh/config\.d' "$ssh_config"; then
  log "Adding ~/.ssh/config.d include to ~/.ssh/config"
  ssh_tmp=$(mktemp "${ssh_config}.XXXXXX")
  {
    printf 'Include ~/.ssh/config.d/*.conf\n\n'
    if [ -e "$ssh_config" ]; then cat "$ssh_config"; fi
  } > "$ssh_tmp"
  chmod 600 "$ssh_tmp"
  # Warn and skip rather than abort: a config that was already broken before
  # bootstrap ran shouldn't stop it installing everything else.
  if ssh -F "$ssh_tmp" -G localhost >/dev/null 2>&1; then
    mv -f "$ssh_tmp" "$ssh_config"
  else
    rm -f "$ssh_tmp"
    log "Skipped ~/.ssh/config edit: candidate failed ssh's parse check, left as-is"
  fi
fi

# fzf keybindings / completion (~/.fzf.zsh)
if [ ! -f "${HOME}/.fzf.zsh" ] && [ -x "$(brew --prefix)/opt/fzf/install" ]; then
  log "Installing fzf shell integration"
  "$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc
fi

# prezto
if [ ! -d "${ZDOTDIR:-$HOME}/.zprezto" ]; then
  log "Installing prezto"
  git clone --recursive https://github.com/sorin-ionescu/prezto.git \
    "${ZDOTDIR:-$HOME}/.zprezto"
fi

# tmux plugins
TPM="${HOME}/.tmux/plugins/tpm"
if [ ! -d "$TPM" ]; then
  log "Installing tpm"
  git clone https://github.com/tmux-plugins/tpm "$TPM"
fi
log "Syncing tmux plugins"
sed -nE "s/^set -g @plugin '([^']+)'.*/  \1/p" "${BASEDIR}/tmux.conf"
"$TPM/bin/install_plugins" >/dev/null

# rust
if [ ! -f "${HOME}/.cargo/env" ]; then
  log "Installing rustup"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

log "Bootstrap complete"
