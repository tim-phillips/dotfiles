#!/usr/bin/env bash
#
# wm — run workmux against the always-on mini instead of the local machine.
#
# Walk-away agent sessions belong on a host that doesn't sleep in a bag, so
# they keep working while the laptop is closed and stay reachable from any
# device. This wraps workmux so the remote host is the default and local is
# the opt-out (`wml`), because a habit you'd have to remember loses to one
# you'd have to actively bypass.
#
# Layout on the host: ~/work/<project> and ~/personal/<project>. The path
# prefix *is* the context — there's no registry to drift, and workmux has no
# project registry of its own to hang it off.
#
# Context defaults to personal. The work machine sets `export WM_CONTEXT=work`
# in ~/.zprofile.local (untracked, machine-local).

set -euo pipefail

WM_HOST="${WM_HOST:-mini}"
WM_CONTEXT="${WM_CONTEXT:-personal}"

die() { printf 'wm: %s\n' "$*" >&2; exit 1; }

# On the host itself there's nothing to dispatch.
if [[ "$(hostname -s)" == "$WM_HOST" ]]; then
  exec workmux "$@"
fi

[[ $# -gt 0 ]] || die "usage: wm <workmux-subcommand> [args...]"

# Which project? Derived from the local repo you're standing in, mapped onto
# the host by basename. Keeps `wm add` feeling identical to `workmux add`.
if ! local_root=$(git rev-parse --show-toplevel 2>/dev/null); then
  die "not in a git repository (cd into the project you want to work on)"
fi
project=$(basename "$local_root")
remote_dir="\$HOME/$WM_CONTEXT/$project"

# Fail with something actionable rather than a bare shell error.
if ! ssh "$WM_HOST" "[ -d $remote_dir ]" 2>/dev/null; then
  die "$WM_HOST has no $WM_CONTEXT/$project — clone it there first, or set WM_CONTEXT"
fi

subcommand=$1

if [[ "$subcommand" == "add" ]]; then
  # Base the worktree on the *fetched* tip of whatever branch you're standing
  # in locally. One rule covers both cases: on develop you get a current
  # develop rather than whatever the host last pulled, and on a feature branch
  # you stack on it, which is the reason you're standing there.
  #
  # It has to happen here because workmux won't do it -- it bases on the
  # host's checked-out branch, its own docs say detection "does not fetch",
  # and there's no pre-create hook to bolt it onto.
  #
  # Skipped when the invocation already decides its own base: --pr checks out
  # someone else's branch, and an explicit --base is the escape hatch.
  inject_base=1
  for arg in "${@:2}"; do
    case "$arg" in
      --base | --base=* | --pr | --pr=*) inject_base=0; break ;;
    esac
  done

  base_ref=""
  if (( inject_base )) && branch=$(git symbolic-ref --quiet --short HEAD); then
    printf -v q_branch '%q' "$branch"
    # The fetch fails noisily on a branch that was never pushed, so let it go
    # quiet and let rev-parse be what decides -- then the error can name the
    # actual problem instead of echoing git's.
    if ! ssh "$WM_HOST" "cd $remote_dir &&
           git fetch --quiet origin $q_branch 2>/dev/null;
           git rev-parse --verify --quiet origin/$q_branch >/dev/null"; then
      die "$WM_HOST can't see origin/$branch — push the branch first, or pass --base"
    fi
    base_ref="origin/$branch"
  fi

  # `add` needs flags remotely that it doesn't need locally: there's no
  # attached tmux session over SSH, so the window needs an explicit parent and
  # must not try to switch to itself. One session per context keeps work and
  # personal windows separated on the host as well as on disk.
  ssh "$WM_HOST" "tmux has-session -t $WM_CONTEXT 2>/dev/null || tmux new-session -d -s $WM_CONTEXT"

  # Spelled out twice rather than built in an array: this runs under bash 3.2,
  # where expanding an empty array trips `set -u`.
  if [[ -n "$base_ref" ]]; then
    set -- "$subcommand" --parent-session "$WM_CONTEXT" --background \
           --base "$base_ref" "${@:2}"
  else
    set -- "$subcommand" --parent-session "$WM_CONTEXT" --background "${@:2}"
  fi
fi

# printf %q so prompts containing spaces and quotes survive the trip.
printf -v remote_args '%q ' "$@"
ssh "$WM_HOST" "cd $remote_dir && workmux $remote_args"
